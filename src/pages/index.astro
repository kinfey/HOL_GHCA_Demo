---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames, getGameCategories, getGamePublishers } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const games = await getAllGames(db);
const categories = await getGameCategories(db);
const publishers = await getGamePublishers(db);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <section
            class="mb-8 p-6 rounded-xl bg-slate-800/60 border border-slate-700"
            aria-labelledby="games-filter-heading"
            data-testid="games-filter-controls"
          >
            <h3 id="games-filter-heading" class="text-xl font-medium text-slate-100 mb-4">Filter games</h3>
            <form class="space-y-4" data-testid="games-filter-form">
              <fieldset>
                <legend class="text-sm font-medium text-slate-200 mb-3">Categories</legend>
                <div class="flex flex-wrap gap-2">
                  {categories.map((category) => (
                    <label
                      for={`category-filter-${category.id}`}
                      class="inline-flex items-center gap-2 px-3 py-2 rounded-lg border border-slate-600 bg-slate-900/60 text-slate-200 hover:bg-slate-700 transition-colors duration-200"
                    >
                      <input
                        id={`category-filter-${category.id}`}
                        type="checkbox"
                        name="category-filter"
                        value={category.id}
                        data-testid={`category-filter-${category.id}`}
                        class="h-4 w-4 rounded border-slate-500 bg-slate-800 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                      />
                      <span>{category.name}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <div class="flex flex-col gap-2 sm:max-w-sm">
                <label for="publisher-filter-select" class="text-sm font-medium text-slate-200">Publisher</label>
                <select
                  id="publisher-filter-select"
                  data-testid="publisher-filter-select"
                  class="px-3 py-2 rounded-lg border border-slate-600 bg-slate-900 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                >
                  <option value="">All publishers</option>
                  {publishers.map((publisher) => (
                    <option value={publisher.id}>{publisher.name}</option>
                  ))}
                </select>
              </div>

              <button
                type="button"
                data-testid="clear-filters-button"
                class="inline-flex items-center px-4 py-2 rounded-lg border border-slate-600 bg-slate-900 text-slate-200 hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none transition-colors duration-200"
              >
                Clear filters
              </button>
            </form>
            <p class="mt-4 text-sm text-slate-300" data-testid="filter-results-count" role="status" aria-live="polite">
              Showing {games.length} of {games.length} games
            </p>
          </section>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div class="hidden mt-6" data-testid="filtered-empty-state">
            <EmptyState text="No games match your current filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector('[data-testid="games-filter-form"]');
  const gameCards = Array.from(document.querySelectorAll('[data-testid="game-card"]'));
  const filteredEmptyState = document.querySelector('[data-testid="filtered-empty-state"]');
  const resultsCount = document.querySelector('[data-testid="filter-results-count"]');

  if (filterForm && gameCards.length > 0 && filteredEmptyState && resultsCount) {
    const categoryInputs = Array.from(
      filterForm.querySelectorAll('input[name="category-filter"]')
    );
    const publisherSelect = filterForm.querySelector('[data-testid="publisher-filter-select"]');
    const clearButton = filterForm.querySelector('[data-testid="clear-filters-button"]');

    const applyFilters = () => {
      const selectedCategories = new Set(
        categoryInputs.filter((input) => input.checked).map((input) => input.value)
      );
      const selectedPublisher = publisherSelect?.value ?? '';

      let visibleCount = 0;
      for (const card of gameCards) {
        const cardCategoryId = card.getAttribute('data-game-category-id') ?? '';
        const cardPublisherId = card.getAttribute('data-game-publisher-id') ?? '';
        const matchesCategory =
          selectedCategories.size === 0 || selectedCategories.has(cardCategoryId);
        const matchesPublisher = selectedPublisher === '' || selectedPublisher === cardPublisherId;
        const isVisible = matchesCategory && matchesPublisher;

        card.classList.toggle('hidden', !isVisible);
        if (isVisible) visibleCount += 1;
      }

      filteredEmptyState.classList.toggle('hidden', visibleCount > 0);
      resultsCount.textContent = `Showing ${visibleCount} of ${gameCards.length} games`;
    };

    for (const categoryInput of categoryInputs) {
      categoryInput.addEventListener('change', applyFilters);
    }
    publisherSelect?.addEventListener('change', applyFilters);
    clearButton?.addEventListener('click', () => {
      for (const categoryInput of categoryInputs) {
        categoryInput.checked = false;
      }
      if (publisherSelect) {
        publisherSelect.value = '';
      }
      applyFilters();
    });

    applyFilters();
  }
</script>
